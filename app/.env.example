# Copie este arquivo para .env e preencha os valores (o .env não vai para o Git).

# Chave do openrouteservice, usada para calcular a rota do caminhão.
# Crie uma conta gratuita em https://openrouteservice.org/dev/#/signup e copie o token do painel.
ORS_API_KEY=

# Porta do servidor Express (o Vite, em http://localhost:5173, repassa /api para ela).
PORT=8787

# Endereços da API PHP (pasta api) no seu Apache. Ajuste se o projeto estiver em outra pasta
# ou porta, por exemplo: http://localhost:8080/meu-projeto/api/usuarios.php
USER_API_URL=http://localhost/ecoleta/api/dados_usuario.php
USUARIOS_API_URL=http://localhost/ecoleta/api/usuarios.php

# Chave que assina o cookie de sessão. Gere com: openssl rand -hex 32
SESSION_SECRET=

# Token que a API PHP exige. Gere com: openssl rand -hex 32
# Precisa ser IGUAL ao "token_interno" de api/config.php.
INTERNAL_API_TOKEN=

# Opcional: caminho do dados_usuario.php que o servidor observa para atualizar o mapa ao salvar.
# Padrão: ../api/dados_usuario.php
# USER_API_FILE=
